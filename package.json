{
	"name": "aspen-monorepo",
	"private": true,
	"type": "module",
	"description": "Aspen: a dynamic nested-tree engine backed by typed arrays, and its React bindings",
	"license": "MIT",
	"author": "Neek Sandhu <neek.sandhu@outlook.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zikaari/aspen.git"
	},
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": "^22.18.0 || ^24.11.0 || >=26.0.0"
	},
	"scripts": {
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run --passWithNoTests",
		"verify": "pnpm lint && pnpm typecheck && pnpm build",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "0.18.5",
		"@biomejs/biome": "2.6.8",
		"@changesets/cli": "3.0.3",
		"publint": "0.3.25",
		"tsdown": "0.23.7",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	}
}
