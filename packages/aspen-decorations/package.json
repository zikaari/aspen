{
	"name": "aspen-decorations",
	"version": "2.0.0-alpha.0",
	"description": "Styling engine for Aspen: apply, inherit and negate CSS classes across a tree",
	"keywords": [
		"tree",
		"decorations",
		"styling",
		"css",
		"inheritance"
	],
	"license": "MIT",
	"author": "Neek Sandhu <neek.sandhu@outlook.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zikaari/aspen.git",
		"directory": "packages/aspen-decorations"
	},
	"homepage": "https://github.com/zikaari/aspen#readme",
	"bugs": {
		"url": "https://github.com/zikaari/aspen/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@aspen/source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"aspen-core": "workspace:^"
	},
	"devDependencies": {
		"aspen-core": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	}
}
