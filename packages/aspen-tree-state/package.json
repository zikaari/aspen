{
	"name": "aspen-tree-state",
	"version": "2.0.0-alpha.0",
	"description": "Save and restore which branches of an Aspen tree are expanded, and where it is scrolled to",
	"keywords": [
		"tree",
		"state",
		"persistence",
		"restore"
	],
	"license": "MIT",
	"author": "Neek Sandhu <neek.sandhu@outlook.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zikaari/aspen.git",
		"directory": "packages/aspen-tree-state"
	},
	"homepage": "https://github.com/zikaari/aspen#readme",
	"bugs": {
		"url": "https://github.com/zikaari/aspen/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"@aspen/source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"aspen-core": "workspace:^",
		"aspen-tree-model": "workspace:^"
	},
	"devDependencies": {
		"aspen-core": "workspace:*",
		"aspen-tree-model": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	}
}
